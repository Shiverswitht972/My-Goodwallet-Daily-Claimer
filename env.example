# ─── GoodDollar Auto-Claimer — Environment Config ─────────────────────────────
# Copy this file to .env and fill in your values
# ⚠️  NEVER commit your .env file to git!

# ─── Wallet ───────────────────────────────────────────────────────────────────
# Your GoodDollar-verified wallet private key (with or without 0x prefix)
WALLET_PRIVATE_KEY=your_private_key_here

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram → /newbot
# 2. Copy the token it gives you below
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 3. Get your chat ID:
#    - Message your bot, then open:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    - Look for "chat":{"id": XXXXXX}  ← that number is your TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Networks ─────────────────────────────────────────────────────────────────
# Set to "false" to disable a network (both enabled by default)
ENABLE_CELO=true
ENABLE_FUSE=true

# Optional: override default public RPC endpoints (useful if public RPCs are slow)
# CELO_RPC_URL=https://forno.celo.org
# FUSE_RPC_URL=https://rpc.fuse.io

# ─── Scheduler ────────────────────────────────────────────────────────────────
# When to run the daily claim (cron syntax, UTC timezone)
# Default: every day at 09:00 UTC
# Examples:
#   "0 9 * * *"   → 9:00 AM UTC daily
#   "30 6 * * *"  → 6:30 AM UTC daily
#   "0 */12 * * *"→ every 12 hours (for testing)
CRON_SCHEDULE=0 9 * * *

# Set to "true" to run a claim immediately when the bot starts up
CLAIM_ON_START=false
